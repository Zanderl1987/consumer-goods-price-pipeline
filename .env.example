# Consumer-goods-price-pipeline secrets — copy to .env and fill in the keys
# you want. Most pipelines work keyless or with a free-tier key; see
# docs/PIPELINE_CATALOG.md for which key each pipeline needs.

# BLS (Bureau of Labor Statistics) — free v2 key at https://data.bls.gov/registrationEngine/
# Without it the pipelines fall back to v1 (no key, lower request limits).
BLS_API_KEY=your_bls_api_key_here

# USDA NASS QuickStats — free key at https://quickstats.nass.usda.gov/api
USDA_NASS_API_KEY=your_usda_nass_api_key_here
USDA_NASS_API_KEY_2=your_usda_nass_backup_key_here

# USDA AMS Market News — free key via registration at https://mymarketnews.ams.usda.gov/
USDA_AMS_API_KEY=your_usda_ams_api_key_here

# EIA (U.S. Energy Information Administration) — free key at https://www.eia.gov/opendata/register.php
EIA_API_KEY=your_eia_api_key_here

# FRED (St. Louis Fed) — free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# ── Retail / e-commerce (free tiers, each needs its own registration) ──────
# eBay — free App ID (OAuth client) at https://developer.ebay.com
EBAY_APP_ID=your_ebay_app_id_here

# Walmart Affiliate / Product API — https://developer.walmart.com (free tier)
WALMART_API_KEY=your_walmart_api_key_here

# Kroger — https://developer.kroger.com (free, instant self-serve signup)
# A self-serve app is registered in the Certification environment, which
# authenticates against api-ce.kroger.com, NOT api.kroger.com (verified live
# 2026-08-04 -- api.kroger.com 401s "invalid credentials" for a Certification
# app). The pipeline defaults to Certification; set KROGER_ENV=production
# below only if you have a Production-tier app (requires Kroger approval).
KROGER_CLIENT_ID=your_kroger_client_id_here
KROGER_CLIENT_SECRET=your_kroger_client_secret_here
# KROGER_ENV=production

# Open Food Facts — keyless (no key needed)
